; Stage-4 frame inspector only. No game or original resources included.
config_version=5

[application]
config/name="Baram restoration frame inspector"
run/main_scene="res://viewer.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=640

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)
